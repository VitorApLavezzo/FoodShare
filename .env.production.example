# Copie para .env NA VPS e preencha. Nunca faça commit do .env.
# Gere segredos com:  openssl rand -hex 32

# IP público da VPS (sem http://). Quando tiver domínio, troque aqui.
PUBLIC_HOST=203.0.113.10

# Portas expostas na VPS (troque se já estiverem em uso).
API_PORT=3000
WEB_PORT=80
# Se WEB_PORT não for 80, preencha com ":PORTA" (ex.: WEB_PORT_SUFFIX=:8080)
WEB_PORT_SUFFIX=

# Use só letras e números (vai dentro da URL de conexão do banco).
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=

# Opcional: SMTP para e-mails (recuperação de senha). Sem MAIL_HOST, os e-mails só vão para o log.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=FoodShare <nao-responda@seudominio.com>
