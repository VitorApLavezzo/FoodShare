// FoodShare - schema de dados
// Decisões:
// - Todas as entidades distribuídas relevantes possuem nodeId + version (optimistic locking / rastreio de origem).
// - Reserva de doação usa transação + lock de linha (SELECT ... FOR UPDATE) no service, não apenas Prisma default.
// - Soft delete via campo deletedAt onde aplicável (organizations, donations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Usuários ----------

enum UserRole {
  ADMIN
  DONOR
  NGO
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  nodeId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationLinks OrganizationUser[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pickupsConfirmed  Pickup[]           @relation("PickupConfirmedBy")
  messages          Message[]

  @@index([role])
  @@index([nodeId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Organizações (Doadores e ONGs) ----------

enum OrganizationType {
  RESTAURANT
  MARKET
  BAKERY
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

model Address {
  id           String   @id @default(uuid())
  street       String
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations Organization[]

  @@index([city, state])
  @@index([latitude, longitude])
  @@map("addresses")
}

// Um único modelo Organization cobre Doador e ONG (kind), evitando duplicação de
// campos comuns (endereço, aprovação, contato). Regras específicas de cada perfil
// (ex.: capacidade de atendimento para ONG) ficam em campos opcionais.
enum OrganizationKind {
  DONOR
  NGO
}

model Organization {
  id                   String            @id @default(uuid())
  kind                 OrganizationKind
  legalName            String
  tradeName            String
  document             String? // CNPJ, opcional para ONGs informais
  type                 OrganizationType?
  phone                String
  email                String
  responsibleName      String
  description          String?
  operatingHours       String?
  estimatedCapacity    Int? // capacidade aproximada de atendimento (ONG)
  notificationRadiusKm Int? // ONG: raio (km) para alertas de doação próxima; null usa o padrão global
  approvalStatus       ApprovalStatus    @default(PENDING)
  nodeId               String
  version              Int               @default(1)
  addressId            String
  address              Address           @relation(fields: [addressId], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  users         OrganizationUser[]
  donationLists DonationList[]     @relation("DonorOrganization")
  reservations  Reservation[]      @relation("NgoOrganization")

  @@index([kind, approvalStatus])
  @@map("organizations")
}

model OrganizationUser {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_users")
}

// ---------- Doações ----------

enum DonationCategory {
  PREPARED_MEALS
  FRUITS
  VEGETABLES
  LEGUMES
  PACKAGED_GOODS
  BAKERY
  BEVERAGES
  OTHER
}

// Estados terminais: CANCELLED (doador desistiu), EXPIRED (venceu sem ser
// retirada) e CLOSED (tudo que foi reservado acabou sendo retirado).
enum DonationListStatus {
  OPEN
  FULLY_RESERVED
  CANCELLED
  CLOSED
  EXPIRED
}

// Toda doação é uma lista de 1+ itens. Doador decide em allowPartial se a ONG
// pode reservar item a item/parcialmente ou só a lista inteira de uma vez.
model DonationList {
  id                  String             @id @default(uuid())
  donorOrganizationId String
  donorOrganization   Organization       @relation("DonorOrganization", fields: [donorOrganizationId], references: [id])
  nodeId              String
  allowPartial        Boolean            @default(true)
  status              DonationListStatus @default(OPEN)
  notes               String?
  availableAt         DateTime
  pickupDeadline      DateTime
  expiresAt           DateTime
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  items         DonationItem[]
  reservations  Reservation[]
  conversations Conversation[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([expiresAt])
  @@index([nodeId])
  @@index([donorOrganizationId])
  @@map("donation_lists")
}

enum DonationItemStatus {
  AVAILABLE
  FULLY_RESERVED
  CANCELLED
  EXPIRED
}

model DonationItem {
  id                String             @id @default(uuid())
  donationListId    String
  donationList      DonationList       @relation(fields: [donationListId], references: [id])
  foodName          String
  category          DonationCategory
  description       String?
  // Decimal (não Float): quantidade sofre soma/subtração repetida a cada reserva
  // parcial e cancelamento — binário flutuante acumularia resto (ex.: item
  // "zerado" ficando em 1e-17 e nunca saindo de AVAILABLE).
  quantity          Decimal            @db.Decimal(12, 3)
  remainingQuantity Decimal            @db.Decimal(12, 3)
  unit              String
  batch             String?
  storageCondition  String?
  status            DonationItemStatus @default(AVAILABLE)
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reservationItems ReservationItem[]

  @@index([status])
  @@index([category])
  @@index([donationListId])
  @@map("donation_items")
}

// ---------- Reservas / Retiradas ----------

enum ReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  EXPIRED // ONG não retirou até o prazo: quantidade devolvida à lista (no-show)
}

model Reservation {
  id                String            @id @default(uuid())
  donationListId    String
  donationList      DonationList      @relation(fields: [donationListId], references: [id])
  ngoOrganizationId String
  ngoOrganization   Organization      @relation("NgoOrganization", fields: [ngoOrganizationId], references: [id])
  status            ReservationStatus @default(ACTIVE)
  reservedAt        DateTime          @default(now())
  cancelledAt       DateTime?
  pickupCode        String            @unique
  nodeId            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items        ReservationItem[]
  pickup       Pickup?
  conversation Conversation?

  @@index([status])
  @@index([donationListId])
  @@index([ngoOrganizationId])
  @@map("reservations")
}

model ReservationItem {
  id             String       @id @default(uuid())
  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  donationItemId String
  donationItem   DonationItem @relation(fields: [donationItemId], references: [id])
  quantity       Decimal      @db.Decimal(12, 3)

  @@index([reservationId])
  @@index([donationItemId])
  @@map("reservation_items")
}

// ---------- Chat (doador <-> ONG por reserva) ----------

model Conversation {
  id             String       @id @default(uuid())
  reservationId  String       @unique
  reservation    Reservation  @relation(fields: [reservationId], references: [id])
  donationListId String
  donationList   DonationList @relation(fields: [donationListId], references: [id])
  createdAt      DateTime     @default(now())

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  senderUser     User         @relation(fields: [senderUserId], references: [id])
  body           String
  nodeId         String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Pickup {
  id                String      @id @default(uuid())
  reservationId     String      @unique
  reservation       Reservation @relation(fields: [reservationId], references: [id])
  confirmedByUserId String
  confirmedByUser   User        @relation("PickupConfirmedBy", fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime    @default(now())
  notes             String?
  nodeId            String

  @@map("pickups")
}

// ---------- Nós distribuídos / Sincronização ----------

enum NodeStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

model Node {
  id            String     @id @default(uuid())
  code          String     @unique // ex: LIMEIRA
  name          String
  city          String
  state         String
  status        NodeStatus @default(OFFLINE)
  endpoint      String?
  lastHeartbeat DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("nodes")
}

enum SyncEventStatus {
  PENDING
  SYNCED
  FAILED
}

model SyncEvent {
  id            String          @id @default(uuid())
  eventId       String          @unique // uuid global, usado para idempotência
  originNode    String
  // autoincrement do banco: antes a sequência vinha de um count() da tabela
  // inteira a cada publicação — custo crescente e sujeito a corrida (duas
  // publicações simultâneas recebiam o mesmo número).
  sequence      BigInt          @default(autoincrement())
  eventType     String
  entityId      String
  payload       Json
  status        SyncEventStatus @default(PENDING)
  retryCount    Int             @default(0)
  errorMessage  String?
  correlationId String?
  createdAt     DateTime        @default(now())
  syncedAt      DateTime?

  @@index([status])
  @@index([originNode])
  @@map("sync_events")
}

// ---------- Auditoria ----------

model AuditLog {
  id             String        @id @default(uuid())
  entity         String
  entityId       String
  eventType      String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  donationListId String?
  donationList   DonationList? @relation(fields: [donationListId], references: [id])
  nodeId         String
  previousData   Json?
  newData        Json?
  correlationId  String?
  createdAt      DateTime      @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([donationListId])
  @@map("audit_logs")
}

// ---------- Notificações ----------

enum NotificationType {
  NEW_DONATION_NEARBY
  RESERVATION_DEADLINE_SOON
  DONATION_RESERVED
  PICKUP_CONFIRMED
  GENERIC
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  donationListId String?
  donationList   DonationList?    @relation(fields: [donationListId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
  @@index([donationListId])
  @@map("notifications")
}
