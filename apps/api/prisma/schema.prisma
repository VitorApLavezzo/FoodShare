// FoodShare - schema de dados
// Decisões:
// - Todas as entidades distribuídas relevantes possuem nodeId + version (optimistic locking / rastreio de origem).
// - Reserva de doação usa transação + lock de linha (SELECT ... FOR UPDATE) no service, não apenas Prisma default.
// - Soft delete via campo deletedAt onde aplicável (organizations, donations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Usuários ----------

enum UserRole {
  ADMIN
  DONOR
  NGO
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              UserRole
  isActive          Boolean   @default(true)
  // Motivo do bloqueio administrativo, mostrado ao usuário no login.
  deactivatedReason String?
  emailVerifiedAt   DateTime?
  nodeId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Exclusão de conta (LGPD): os dados pessoais são anonimizados e a conta
  // marcada aqui, preservando o histórico de doações já entregues.
  deletedAt         DateTime?

  organizationLinks OrganizationUser[]
  refreshTokens     RefreshToken[]
  tokens            UserToken[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pickupsConfirmed  Pickup[]           @relation("PickupConfirmedBy")
  messages          Message[]

  @@index([role])
  @@index([nodeId])
  @@map("users")
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Uma tabela para os dois fluxos de token por e-mail: só muda o propósito e a
// validade. Guarda o hash, nunca o token em si — quem tiver acesso de leitura
// ao banco não consegue redefinir a senha de ninguém.
model UserToken {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String           @unique
  purpose   UserTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@map("user_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Organizações (Doadores e ONGs) ----------

enum OrganizationType {
  RESTAURANT
  MARKET
  BAKERY
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

model Address {
  id           String   @id @default(uuid())
  street       String
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations Organization[]

  @@index([city, state])
  @@index([latitude, longitude])
  @@map("addresses")
}

// Um único modelo Organization cobre Doador e ONG (kind), evitando duplicação de
// campos comuns (endereço, aprovação, contato). Regras específicas de cada perfil
// (ex.: capacidade de atendimento para ONG) ficam em campos opcionais.
enum OrganizationKind {
  DONOR
  NGO
}

model Organization {
  id                     String             @id @default(uuid())
  kind                   OrganizationKind
  legalName              String
  tradeName              String
  document               String? // CNPJ, opcional para ONGs informais
  type                   OrganizationType?
  phone                  String
  email                  String
  responsibleName        String
  description            String?
  operatingHours         String?
  estimatedCapacity      Int? // capacidade aproximada de atendimento (ONG)
  notificationRadiusKm   Int? // ONG: raio (km) para alertas de doação próxima; null usa o padrão global
  // ONG: categorias de interesse. Vazio = recebe alerta de tudo (padrão). Sem
  // isso, toda ONG era avisada de toda doação no raio e o alerta virava ruído.
  notificationCategories DonationCategory[]
  // Reputação: contadores mantidos pelo próprio fluxo (retirada confirmada x
  // reserva abandonada), para que o outro lado consiga avaliar com quem está
  // combinando uma retirada.
  completedPickupCount   Int                @default(0)
  noShowCount            Int                @default(0)
  approvalStatus         ApprovalStatus     @default(PENDING)
  nodeId                 String
  version                Int                @default(1)
  addressId              String
  address                Address            @relation(fields: [addressId], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  users         OrganizationUser[]
  donationLists DonationList[]     @relation("DonorOrganization")
  reservations  Reservation[]      @relation("NgoOrganization")
  templates     DonationTemplate[]

  @@index([kind, approvalStatus])
  @@map("organizations")
}

model OrganizationUser {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_users")
}

// ---------- Doações ----------

// Três categorias amplas, e não uma taxonomia fina: o doador classifica em
// segundos e a ONG filtra alerta por algo que realmente muda a decisão de ir
// buscar (comida pronta tem prazo de horas; natural, de dias; industrializada,
// de meses).
enum DonationCategory {
  PREPARED_MEALS
  PACKAGED_GOODS
  NATURAL_FOODS
}

// Estados terminais: CANCELLED (doador desistiu), EXPIRED (venceu sem ser
// retirada) e CLOSED (tudo que foi reservado acabou sendo retirado).
enum DonationListStatus {
  OPEN
  FULLY_RESERVED
  CANCELLED
  CLOSED
  EXPIRED
}

// Toda doação é uma lista de 1+ itens. Doador decide em allowPartial se a ONG
// pode reservar item a item/parcialmente ou só a lista inteira de uma vez.
model DonationList {
  id                  String             @id @default(uuid())
  donorOrganizationId String
  donorOrganization   Organization       @relation("DonorOrganization", fields: [donorOrganizationId], references: [id])
  nodeId              String
  allowPartial        Boolean            @default(true)
  status              DonationListStatus @default(OPEN)
  notes               String?
  availableAt         DateTime
  // Prazo e validade de verdade moram em cada item (cada alimento tem a sua
  // validade, e com aceite parcial cada um pode ter seu prazo de retirada).
  // Aqui fica o mais tardio de cada um: é o que diz até quando a lista inteira
  // ainda pode ter alguma coisa acontecendo.
  pickupDeadline      DateTime
  expiresAt           DateTime
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  items         DonationItem[]
  reservations  Reservation[]
  conversations Conversation[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([expiresAt])
  @@index([nodeId])
  @@index([donorOrganizationId])
  @@map("donation_lists")
}

enum DonationRecurrence {
  DAILY
  WEEKDAYS
  WEEKLY
}

/**
 * Modelo de doação recorrente. Uma padaria com sobra todo dia tinha de
 * recriar a mesma lista manualmente toda noite; aqui ela descreve a oferta uma
 * vez e o agendador publica sozinho.
 */
model DonationTemplate {
  id                  String             @id @default(uuid())
  donorOrganizationId String
  donorOrganization   Organization       @relation(fields: [donorOrganizationId], references: [id], onDelete: Cascade)
  name                String
  allowPartial        Boolean            @default(true)
  notes               String?
  // Itens congelados como JSON: é um molde, não entidades reserváveis — cada
  // publicação gera DonationItems novos a partir daqui.
  items               Json
  recurrence          DonationRecurrence
  // Hora do dia (0-23) em que a lista deve ser publicada.
  hourOfDay           Int
  // Para WEEKLY: dia da semana (0=domingo).
  weekday             Int?
  // Janela da oferta gerada, em horas a partir da publicação. Mesmas regras da
  // doação manual: retirada com ao menos 24h e validade 24h depois dela.
  pickupWindowHours   Int                @default(24)
  expiresInHours      Int                @default(48)
  isActive            Boolean            @default(true)
  lastGeneratedAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([donorOrganizationId])
  @@index([isActive])
  @@map("donation_templates")
}

enum DonationItemStatus {
  AVAILABLE
  FULLY_RESERVED
  CANCELLED
  EXPIRED
}

model DonationItem {
  id                String             @id @default(uuid())
  donationListId    String
  donationList      DonationList       @relation(fields: [donationListId], references: [id])
  foodName          String
  category          DonationCategory
  description       String?
  // Decimal (não Float): quantidade sofre soma/subtração repetida a cada reserva
  // parcial e cancelamento — binário flutuante acumularia resto (ex.: item
  // "zerado" ficando em 1e-17 e nunca saindo de AVAILABLE).
  quantity          Decimal            @db.Decimal(12, 3)
  remainingQuantity Decimal            @db.Decimal(12, 3)
  unit              String
  batch             String?
  storageCondition  String?
  // Foto do alimento: ONG decide se vale a viagem antes de sair, e fica o
  // registro do estado em que o item foi ofertado.
  imageUrl          String?
  allergens         String?
  // Lista sem aceite parcial: todos os itens compartilham o mesmo prazo.
  pickupDeadline    DateTime
  expiresAt         DateTime
  status            DonationItemStatus @default(AVAILABLE)
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reservationItems ReservationItem[]

  @@index([status])
  @@index([category])
  @@index([donationListId])
  @@index([pickupDeadline])
  @@map("donation_items")
}

// ---------- Reservas / Retiradas ----------

enum ReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  EXPIRED // ONG não retirou até o prazo: quantidade devolvida à lista (no-show)
}

model Reservation {
  id                String            @id @default(uuid())
  donationListId    String
  donationList      DonationList      @relation(fields: [donationListId], references: [id])
  ngoOrganizationId String
  ngoOrganization   Organization      @relation("NgoOrganization", fields: [ngoOrganizationId], references: [id])
  status            ReservationStatus @default(ACTIVE)
  reservedAt        DateTime          @default(now())
  cancelledAt       DateTime?
  pickupCode        String            @unique
  nodeId            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items        ReservationItem[]
  pickup       Pickup?
  conversation Conversation?

  @@index([status])
  @@index([donationListId])
  @@index([ngoOrganizationId])
  @@map("reservations")
}

model ReservationItem {
  id             String       @id @default(uuid())
  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  donationItemId String
  donationItem   DonationItem @relation(fields: [donationItemId], references: [id])
  quantity       Decimal      @db.Decimal(12, 3)

  @@index([reservationId])
  @@index([donationItemId])
  @@map("reservation_items")
}

// ---------- Chat (doador <-> ONG por reserva) ----------

model Conversation {
  id             String       @id @default(uuid())
  reservationId  String       @unique
  reservation    Reservation  @relation(fields: [reservationId], references: [id])
  donationListId String
  donationList   DonationList @relation(fields: [donationListId], references: [id])
  createdAt      DateTime     @default(now())

  messages      Message[]
  notifications Notification[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  senderUser     User         @relation(fields: [senderUserId], references: [id])
  body           String
  nodeId         String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Pickup {
  id                String      @id @default(uuid())
  reservationId     String      @unique
  reservation       Reservation @relation(fields: [reservationId], references: [id])
  confirmedByUserId String
  confirmedByUser   User        @relation("PickupConfirmedBy", fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime    @default(now())
  notes             String?
  nodeId            String

  @@map("pickups")
}

// ---------- Nós distribuídos / Sincronização ----------

enum NodeStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

model Node {
  id            String     @id @default(uuid())
  code          String     @unique // ex: LIMEIRA
  name          String
  city          String
  state         String
  status        NodeStatus @default(OFFLINE)
  endpoint      String?
  lastHeartbeat DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("nodes")
}

enum SyncEventStatus {
  PENDING
  SYNCED
  FAILED
}

model SyncEvent {
  id            String          @id @default(uuid())
  eventId       String          @unique // uuid global, usado para idempotência
  originNode    String
  // autoincrement do banco: antes a sequência vinha de um count() da tabela
  // inteira a cada publicação — custo crescente e sujeito a corrida (duas
  // publicações simultâneas recebiam o mesmo número).
  sequence      BigInt          @default(autoincrement())
  eventType     String
  entityId      String
  payload       Json
  status        SyncEventStatus @default(PENDING)
  retryCount    Int             @default(0)
  errorMessage  String?
  correlationId String?
  createdAt     DateTime        @default(now())
  syncedAt      DateTime?

  @@index([status])
  @@index([originNode])
  @@map("sync_events")
}

// ---------- Auditoria ----------

model AuditLog {
  id             String        @id @default(uuid())
  entity         String
  entityId       String
  eventType      String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  donationListId String?
  donationList   DonationList? @relation(fields: [donationListId], references: [id])
  nodeId         String
  previousData   Json?
  newData        Json?
  correlationId  String?
  createdAt      DateTime      @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([donationListId])
  @@map("audit_logs")
}

// ---------- Notificações ----------

enum NotificationType {
  NEW_DONATION_NEARBY
  RESERVATION_DEADLINE_SOON
  DONATION_RESERVED
  PICKUP_CONFIRMED
  NEW_MESSAGE
  GENERIC
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  donationListId String?
  donationList   DonationList?    @relation(fields: [donationListId], references: [id], onDelete: Cascade)
  // Alerta de mensagem nova aponta para a conversa, não só para a doação: é o
  // que permite ao sino abrir o chat certo em vez de largar o usuário na tela
  // de detalhe da doação, onde o chat nem aparece.
  conversationId String?
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
  @@index([donationListId])
  @@index([conversationId])
  @@map("notifications")
}
